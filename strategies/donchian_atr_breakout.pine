//@version=5
strategy("Nexa Donchian ATR Breakout — Research",overlay=true,pyramiding=0,process_orders_on_close=true,commission_type=strategy.commission.percent,commission_value=0.10)
channelLen=input.int(40,"Breakout lookback",minval=5)
exitLen=input.int(15,"Trailing exit lookback",minval=2)
atrLen=input.int(14,"ATR length",minval=2)
stopATR=input.float(2.5,"Initial stop ATR",minval=0.5,step=0.25)
allowShort=input.bool(false,"Allow short positions")
upper=ta.highest(high,channelLen)[1]
lower=ta.lowest(low,channelLen)[1]
longExit=ta.lowest(low,exitLen)[1]
shortExit=ta.highest(high,exitLen)[1]
atr=ta.atr(atrLen)
longSignal=barstate.isconfirmed and close>upper
shortSignal=barstate.isconfirmed and allowShort and close<lower
if longSignal and strategy.position_size<=0
    strategy.entry("Long",strategy.long)
if shortSignal and strategy.position_size>=0
    strategy.entry("Short",strategy.short)
if strategy.position_size>0
    strategy.exit("Long stop","Long",stop=math.max(longExit,strategy.position_avg_price-stopATR*atr))
if strategy.position_size<0
    strategy.exit("Short stop","Short",stop=math.min(shortExit,strategy.position_avg_price+stopATR*atr))
plot(upper,"Prior channel high",color=color.lime)
plot(lower,"Prior channel low",color=color.red)
alertcondition(longSignal,"Range breakout long","Confirmed Donchian long breakout")
alertcondition(shortSignal,"Range breakout short","Confirmed Donchian short breakout")

# Railway server settings
PORT=3000

# These may be exposed only to the browser if Supabase RLS is enabled.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# SERVER-ONLY: never add this key to browser JavaScript, Git, or a client bundle.
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_RAILWAY

# Future provider credentials: store only in Railway variables, never in Supabase rows.
CUSTODY_PROVIDER_API_KEY=SET_ONLY_IN_RAILWAY
WALLET_CONNECT_PROJECT_ID=SET_ONLY_IN_RAILWAY

# Operational API. LIVE_TRADING_ENABLED remains false until formal release approval.
APP_BASE_URL=http://localhost:3000
LIVE_TRADING_ENABLED=false
INTERNAL_API_TOKEN=GENERATE_A_LONG_RANDOM_SERVER_ONLY_VALUE
PROVIDER_WEBHOOK_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_VALUE
CUSTODY_PROVIDER_BASE_URL=https://sandbox.example-provider.invalid
CUSTODY_PROVIDER_NAME=unconfigured
MARKET_DATA_BASE_URL=https://api.exchange.coinbase.com
WORKER_INTERVAL_MS=60000

# The worker also advances database-backed paper-arbitrage simulations.
# Keep the worker service online for the full test period (recommended: 30 days).
